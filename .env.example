# FixYourCode Environment Variables Example
# Create a copy of this file named ".env" and add your actual values

# Server configuration
# The port where the application will run
PORT=3000

# API Keys
# Get your Gemini API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Note: Never commit your actual .env file to version control
# This example file is safe to commit as it doesn't contain real credentials 